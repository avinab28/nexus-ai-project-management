# ==============================================================================
# NEXUS AI Project Management — Environment Configuration
# ==============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/nexus_db?schema=public
# For Cloud (Neon/Supabase/Railway): postgresql://user:password@ep-xyz.region.neon.tech/nexus_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_db?schema=public"

# Authentication Secrets
JWT_SECRET="nexus_super_secret_jwt_key_development_change_in_production_98372"
JWT_EXPIRES_IN="7d"

# Google Gemini AI Integration (Optional but recommended)
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=""

# Application Settings
ENABLE_DEMO_ACCOUNTS=true
