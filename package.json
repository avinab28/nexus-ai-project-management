{
  "name": "nexus-ai-project-management",
  "version": "1.0.0",
  "description": "NEXUS — AI Project Management & Workflow Control Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "project-management",
    "ai",
    "workflow",
    "kanban",
    "gantt",
    "gemini",
    "threejs",
    "react",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Avinab",
  "license": "MIT"
}
